{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.judicial-ai.local/citation.schema.json",
  "title": "citation",
  "x-schema-version": "1.0",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "source_type": {
      "enum": [
        "document_page",
        "transcript_segment"
      ]
    },
    "valid": {
      "type": "boolean"
    },
    "source": {
      "type": "object"
    }
  },
  "required": [
    "id",
    "source_type",
    "valid",
    "source"
  ],
  "additionalProperties": true
}