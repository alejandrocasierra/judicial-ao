{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.judicial-ai.local/media.schema.json",
  "title": "media",
  "x-schema-version": "1.0",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "media_type": {
      "enum": [
        "video",
        "audio"
      ]
    },
    "duration_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  },
  "required": [
    "id",
    "sha256",
    "media_type"
  ],
  "additionalProperties": true
}