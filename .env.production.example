# =====================================================================
# PRODUCCIÃ“N (VPS / GCP). Copia a .env y rellena lo marcado con __SET_ME__.
#   cp .env.production.example .env
#   python3 scripts/gen_env.py --template .env.production.example --force --out .env
#   (eso rellena los __GENERATE__ con secretos aleatorios; luego edita dominios y API keys)
# NUNCA subas el .env resultante a Git.
# =====================================================================

# =====================================================================
# Judicial AI Platform â€” variables de entorno / environment variables
# NUNCA subir .env a Git. Valores "__GENERATE__" los rellena
# scripts/gen_env.py con secretos aleatorios.
# NEVER commit .env. "__GENERATE__" values are filled by scripts/gen_env.py
# =====================================================================

# --- AplicaciÃ³n / Application ---
APP_ENV=production
APP_NAME=judicial-ai
# Registry de imÃ¡genes (VPS/GCP). VacÃ­o = imÃ¡genes locales "judicial-ai/*".
# GitLab: registry.gitlab.com/<usuario>/<repo>   (y IMAGE_TAG=latest o un SHA)
REGISTRY_IMAGE=
IMAGE_TAG=latest
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/v1
LOG_LEVEL=INFO
DEFAULT_LOCALE=es
SUPPORTED_LOCALES=es,en
I18N_DIR=packages/i18n
RBAC_POLICY_FILE=config/rbac.yaml
JURISDICTIONS_DIR=config/jurisdictions
CORS_ALLOWED_ORIGINS=https://app.tudominio.com
# Servidor MCP del Chat IA (streamable HTTP; mismo JWT, RLS por llamada)
MCP_SERVER_ENABLED=true
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8100
MCP_ALLOWED_HOSTS=app.tudominio.com
CHAT_HISTORY_TURNS=8
PIPELINE_VERSION=1.0.0
SCHEMA_VERSION=1.0
WEB_BASE_URL=https://app.tudominio.com
# Dominio pÃºblico del despliegue (lo usa el reverse proxy Caddy en producciÃ³n).
# Ej: app.tudominio.com  (debe existir y apuntar a la IP del VPS)
PUBLIC_DOMAIN=app.tudominio.com
# URL pÃºblica del API que usa el NAVEGADOR. Se inyecta en RUNTIME en el contenedor web
# (env API_PUBLIC_URL), asÃ­ NO hay que recompilar. Desarrollo: vacÃ­o (= http://localhost:8000/v1).
# GCP: https://api.tudominio.com/v1  o  /v1  si web y api comparten dominio tras un proxy.
API_PUBLIC_URL=/v1
SMTP_FROM_NAME=
SMTP_FROM_EMAIL=
SMTP_SERVER=
SMTP_PORT=587
SMTP_SECURITY=STARTTLS
SMTP_USERNAME=
SMTP_CC_EMAILS=

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=judicial
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=__GENERATE__
DB_OWNER_USER=judicial_owner        # dueÃ±o del esquema, ejecuta migraciones
DB_OWNER_PASSWORD=__GENERATE__
DB_APP_USER=judicial_app            # rol de la API: sin BYPASSRLS, sin DELETE en evidencia
DB_APP_PASSWORD=__GENERATE__
DB_POOL_SIZE=10
FTS_CONFIG=simple                   # simple = bilingÃ¼e es/en sin stemming
EMBEDDING_DIMENSIONS=1024

# --- Redis / colas ---
REDIS_URL=redis://redis:6379/0
# Celery (workers): broker y backend en bases Redis separadas del rate limit.
# CELERY_TASK_ALWAYS_EAGER=true ejecuta las tareas en proceso (tests/desarrollo sin broker).
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_ALWAYS_EAGER=false
# Minutos sin progreso (updated_at) para que el sweeper devuelva a QUEUED un job
# huÃ©rfano en RUNNING/RETRYING (worker muerto a mitad de ejecuciÃ³n).
# Regla (la exige Settings): JOB_STALE_MINUTES*60 > JOB_TIME_LIMIT_SECONDS (>=2x),
# para que el sweeper nunca barra un job legÃ­timo aÃºn en ejecuciÃ³n.
JOB_STALE_MINUTES=120
# LÃ­mite duro de ejecuciÃ³n de un job (Celery time_limit de run_job).
JOB_TIME_LIMIT_SECONDS=3600

# --- AutenticaciÃ³n / Authentication ---
JWT_SECRET=__GENERATE__
JWT_ALGORITHM=HS256
JWT_ISSUER=judicial-ai
JWT_AUDIENCE=judicial-ai-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=86400
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900
PASSWORD_MIN_LENGTH=12

# --- Rate limits (por usuario/IP, por minuto) ---
# memory es por proceso: no sirve con varios workers/API. redis es el backend
# compartido (obligatorio en producciÃ³n, lo exige core/config.py). En tests se
# fuerza memory explÃ­citamente (ver scripts/setup_cloud_session.sh / bootstrap.sh).
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_QUERIES_PER_MINUTE=30
RATE_LIMIT_UPLOADS_PER_MINUTE=60
# LÃ­mites por organizaciÃ³n (SSD Â§113) â€” protegen el costo compartido entre usuarios
RATE_LIMIT_ORG_QUERIES_PER_MINUTE=300
RATE_LIMIT_ORG_UPLOADS_PER_MINUTE=300

# --- Almacenamiento / Storage (GCS: MISMO bucket y credenciales que en local) ---
STORAGE_BACKEND=gcs
STORAGE_LOCAL_ROOT=var/storage
# GCS nativo usa gcp-credentials.json (GOOGLE_APPLICATION_CREDENTIALS). Los S3_* de abajo
# se usan sÃ³lo si cambias a STORAGE_BACKEND=s3 (S3/MinIO/HMAC de GCS).
S3_ENDPOINT_URL=https://storage.googleapis.com
S3_BUCKET=welladvisor                # bucket GCS compartido (el mismo de local)
S3_REGION=auto
S3_ACCESS_KEY=__GENERATE__
S3_SECRET_KEY=__GENERATE__
S3_PREFIX=judicial-ai/prod           # en local es "judicial-ai/dev"; producciÃ³n usa "judicial-ai/prod"
S3_SSE=                              # vacÃ­o para GCS

# --- Ingesta / Upload ---
UPLOAD_MAX_BYTES_DOCUMENT=104857600
UPLOAD_MAX_BYTES_MEDIA=5368709120
UPLOAD_ALLOWED_DOCUMENT_TYPES=pdf,png,jpeg,tiff,docx
UPLOAD_ALLOWED_MEDIA_TYPES=mp4,mov,wav,mp3,webm
MALWARE_SCANNER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# --- Calidad / Quality ---
OCR_CONFIDENCE_THRESHOLD=0.85
# Google Document AI (vacÃ­o = deshabilitado; necesario para OCR document_ai)
GOOGLE_CLOUD_PROJECT=welladvisor
GOOGLE_CLOUD_LOCATION=us
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=16e9ace786ea8124
GOOGLE_APPLICATION_CREDENTIALS=/srv/gcp-credentials.json   # el compose monta ./gcp-credentials.json ahÃ­
# Alcance OAuth2 y plantilla del endpoint :process (placeholders {location}/{project}/{processor})
GOOGLE_CLOUD_SCOPE=https://www.googleapis.com/auth/cloud-platform
GOOGLE_DOCUMENT_AI_ENDPOINT_TEMPLATE=https://{location}-documentai.googleapis.com/v1/projects/{project}/locations/{location}/processors/{processor}:process
OCR_PROVIDER=docling_layout          # docling_layout | docling | docling_latin | handwriting | tesseract | fake
OCR_HANDWRITING_MODEL=               # modelo image-to-text (HuggingFace) para manuscritos; vacÃ­o = deshabilitado
OCR_TESSERACT_CMD=                   # ruta al ejecutable; requerido si OCR_PROVIDER=tesseract
OCR_TESSERACT_TESSDATA_DIR=          # ruta a carpeta con .traineddata; vacÃ­o = default del binario
OCR_TESSERACT_LANG=spa               # datos de idioma descargados en tessdata
OCR_DPI=300                          # resoluciÃ³n de rasterizado de PDF a imagen
OCR_PREPROCESS=true                  # aplica binarizaciÃ³n adaptativa + deskew + denoise antes de OCR
OCR_STRUCTURE_WITH_MODEL=false       # true = estructura el texto con el modelo LLM activo (lento, ~2-3s/pÃ¡gina)
ASR_CONFIDENCE_THRESHOLD=0.80
ASR_PROVIDER=whisper                 # whisper (local) | fake
ASR_MODEL=base                   # tiny/base/small/medium/large-v1/large-v2/large-v3
ASR_DEVICE=cpu                      # auto | cpu | cuda
ASR_COMPUTE_TYPE=int8                # int8 | float16 | float32
ASR_BEAM_SIZE=1
ASR_BEST_OF=1
ASR_CPU_THREADS=1                    # e2-medium: 1 hilo para no saturar los 2 vCPU
ASR_CHUNK_SECONDS=600                # ASR por tramos (acota memoria; 0 = sin trocear)
OMP_NUM_THREADS=1                    # 1 hilo para BLAS/torch (e2-medium)
MKL_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
TOKENIZERS_PARALLELISM=false
WORKER_MEM_LIMIT=1500m
WORKER_MEDIA_MEM_LIMIT=3000m
ASR_VAD_FILTER=true                  # activa VAD de faster-whisper para omitir silencios
ASR_VAD_PARAMETERS={}                # parÃ¡metros JSON opcionales para VAD; vacÃ­o = defaults de faster-whisper
ASR_MIN_SPEECH_DURATION_MS=250
# --- Medios: tramos y visión (nuevo) ---
ASR_DIARIZATION_CHUNK_SECONDS=900    # diarización por tramos (acota memoria de pyannote)
ASR_DIARIZATION_OVERLAP_SECONDS=10   # solape entre tramos (evita cortar turnos)
VISUAL_ID_STEP_SECONDS=5             # muestreo de frames para identificar hablantes (segundos)
MEDIA_JOB_TIME_LIMIT_SECONDS=21600   # tiempo máximo de un job de medios (ASR/diarización)
ASR_DIARIZATION_TOKEN=               # token de HuggingFace para pyannote.audio; vacÃ­o = fallback por energÃ­a
FFMPEG_PATH=                         # ruta explÃ­cita a ffmpeg.exe; vacÃ­o = imageio-ffmpeg / PATH. En Windows con pyannote.audio 4 debe ser el ffmpeg.exe del build 'full-shared'
HF_TOKEN=                            # token de HuggingFace compartido (pyannote, modelos)

# --- IA / AI providers ---
LLM_PROVIDER=anthropic
LLM_MODEL=__SET_ME__
LLM_API_KEY=__SET_ME__
LLM_API_BASE_URL=https://api.anthropic.com
LLM_API_VERSION=2023-06-01
# Base URL (compatible con OpenAI Chat Completions) de cada proveedor del dashboard /models
OPENAI_BASE_URL=https://api.openai.com
DEEPSEEK_BASE_URL=https://api.deepseek.com
KIMI_BASE_URL=https://api.moonshot.cn
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_SECONDS=60
# Routing por tarea (D4). JSON: {"extract_entities": {"provider":"openai","model":"gpt-4o-mini"},
#   "detect_contradictions": {"provider":"anthropic","model":"claude-3-5-sonnet-20241022"}}.
# Campos omitidos heredan del LLM default. VacÃ­o o ausente = sin routing.
LLM_ROUTING={}
QUESTION_MAX_CHARS=2000
RETRIEVAL_TOP_K=8
# Constante k de Reciprocal Rank Fusion (FTS + vector). Valores usuales: 60.
RETRIEVAL_RRF_K=60
RETRIEVAL_SNIPPET_MAX_CHARS=1500
# FracciÃ³n mÃ­nima de tÃ©rminos de cada afirmaciÃ³n presentes en la evidencia citada (anti-alucinaciÃ³n)
ANSWER_MIN_GROUNDING_OVERLAP=0.6
# FracciÃ³n mÃ­nima de tÃ©rminos de la pregunta que deben existir en el expediente para no abstenerse
ABSTENTION_MIN_TERM_COVERAGE=0.6
PROMPTS_DIR=packages/prompts

# --- Embeddings / bÃºsqueda hÃ­brida ---
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=__SET_ME__
EMBEDDING_API_KEY=__SET_ME__
EMBEDDING_API_BASE_URL=                   # opcional para OpenAI compatible
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_CHARS=8000

# --- Presupuesto por expediente / Case budget ---
CASE_MAX_PROCESSING_COST=100
CASE_MAX_LLM_TOKENS=2000000
CASE_MAX_MEDIA_HOURS=50

# --- Semillas y cuentas de prueba / Seeds & test accounts ---
SEED_DATA_FILE=apps/api/seeds/data/seed_data.yaml
SEED_EMAIL_DOMAIN=example.test      # dominio reservado (RFC 2606), nunca real
SEED_DEFAULT_PASSWORD=__GENERATE__
# Admin de acceso rÃ¡pido (opcional; vacÃ­o = no se crea)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
