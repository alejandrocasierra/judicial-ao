# =====================================================================
# PRODUCCIÓN (VPS / GCP). Copia a .env y rellena lo marcado con __SET_ME__.
#   cp .env.production.example .env
#   python3 scripts/gen_env.py --template .env.production.example --force --out .env
#   (eso rellena los __GENERATE__ con secretos aleatorios; luego edita dominios y API keys)
# NUNCA subas el .env resultante a Git.
# =====================================================================

# =====================================================================
# Judicial AI Platform — variables de entorno / environment variables
# NUNCA subir .env a Git. Valores "__GENERATE__" los rellena
# scripts/gen_env.py con secretos aleatorios.
# NEVER commit .env. "__GENERATE__" values are filled by scripts/gen_env.py
# =====================================================================

# --- Aplicación / Application ---
APP_ENV=production
APP_NAME=judicial-ai
# Registry de imágenes (VPS/GCP). Vacío = imágenes locales "judicial-ai/*".
# GitLab: registry.gitlab.com/<usuario>/<repo>   (y IMAGE_TAG=latest o un SHA)
REGISTRY_IMAGE=
IMAGE_TAG=latest
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/v1
LOG_LEVEL=INFO
DEFAULT_LOCALE=es
SUPPORTED_LOCALES=es,en
I18N_DIR=packages/i18n
RBAC_POLICY_FILE=config/rbac.yaml
JURISDICTIONS_DIR=config/jurisdictions
CORS_ALLOWED_ORIGINS=https://app.tudominio.com
# Servidor MCP del Chat IA (streamable HTTP; mismo JWT, RLS por llamada)
MCP_SERVER_ENABLED=true
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8100
MCP_ALLOWED_HOSTS=app.tudominio.com
CHAT_HISTORY_TURNS=8
PIPELINE_VERSION=1.0.0
SCHEMA_VERSION=1.0
WEB_BASE_URL=https://app.tudominio.com
# Dominio público del despliegue (lo usa el reverse proxy Caddy en producción).
# Ej: app.tudominio.com  (debe existir y apuntar a la IP del VPS)
PUBLIC_DOMAIN=app.tudominio.com
# URL pública del API que usa el NAVEGADOR. Se inyecta en RUNTIME en el contenedor web
# (env API_PUBLIC_URL), así NO hay que recompilar. Desarrollo: vacío (= http://localhost:8000/v1).
# GCP: https://api.tudominio.com/v1  o  /v1  si web y api comparten dominio tras un proxy.
API_PUBLIC_URL=/v1
SMTP_FROM_NAME=
SMTP_FROM_EMAIL=
SMTP_SERVER=
SMTP_PORT=587
SMTP_SECURITY=STARTTLS
SMTP_USERNAME=
SMTP_CC_EMAILS=

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=judicial
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=__GENERATE__
DB_OWNER_USER=judicial_owner        # dueño del esquema, ejecuta migraciones
DB_OWNER_PASSWORD=__GENERATE__
DB_APP_USER=judicial_app            # rol de la API: sin BYPASSRLS, sin DELETE en evidencia
DB_APP_PASSWORD=__GENERATE__
DB_POOL_SIZE=10
FTS_CONFIG=simple                   # simple = bilingüe es/en sin stemming
EMBEDDING_DIMENSIONS=1024

# --- Redis / colas ---
REDIS_URL=redis://redis:6379/0
# Celery (workers): broker y backend en bases Redis separadas del rate limit.
# CELERY_TASK_ALWAYS_EAGER=true ejecuta las tareas en proceso (tests/desarrollo sin broker).
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_ALWAYS_EAGER=false
# Minutos sin progreso (updated_at) para que el sweeper devuelva a QUEUED un job
# huérfano en RUNNING/RETRYING (worker muerto a mitad de ejecución).
# Regla (la exige Settings): JOB_STALE_MINUTES*60 > JOB_TIME_LIMIT_SECONDS (>=2x),
# para que el sweeper nunca barra un job legítimo aún en ejecución.
JOB_STALE_MINUTES=120
# Límite duro de ejecución de un job (Celery time_limit de run_job).
JOB_TIME_LIMIT_SECONDS=3600

# --- Autenticación / Authentication ---
JWT_SECRET=__GENERATE__
JWT_ALGORITHM=HS256
JWT_ISSUER=judicial-ai
JWT_AUDIENCE=judicial-ai-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=86400
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900
PASSWORD_MIN_LENGTH=12

# --- Rate limits (por usuario/IP, por minuto) ---
# memory es por proceso: no sirve con varios workers/API. redis es el backend
# compartido (obligatorio en producción, lo exige core/config.py). En tests se
# fuerza memory explícitamente (ver scripts/setup_cloud_session.sh / bootstrap.sh).
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_QUERIES_PER_MINUTE=30
RATE_LIMIT_UPLOADS_PER_MINUTE=60
# Límites por organización (SSD §113) — protegen el costo compartido entre usuarios
RATE_LIMIT_ORG_QUERIES_PER_MINUTE=300
RATE_LIMIT_ORG_UPLOADS_PER_MINUTE=300

# --- Almacenamiento / Storage ---
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=var/storage
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_BUCKET=judicial-originals
S3_REGION=us-east-1
S3_ACCESS_KEY=__GENERATE__
S3_SECRET_KEY=__GENERATE__
S3_PREFIX=                          # carpeta dentro del bucket, ej. "judicial-ai/prod" (vacío = raíz)
S3_SSE=AES256                       # "AES256" para S3/MinIO; vacío para Google Cloud Storage
# Google Cloud Storage (compatible S3): S3_ENDPOINT_URL=https://storage.googleapis.com,
# S3_BUCKET=welladvisor, S3_REGION=auto, S3_PREFIX=judicial-ai/prod, S3_SSE=
# y claves HMAC (Cloud Storage → Interoperability) en S3_ACCESS_KEY/S3_SECRET_KEY.

# --- Ingesta / Upload ---
UPLOAD_MAX_BYTES_DOCUMENT=104857600
UPLOAD_MAX_BYTES_MEDIA=5368709120
UPLOAD_ALLOWED_DOCUMENT_TYPES=pdf,png,jpeg,tiff,docx
UPLOAD_ALLOWED_MEDIA_TYPES=mp4,mov,wav,mp3,webm
MALWARE_SCANNER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# --- Calidad / Quality ---
OCR_CONFIDENCE_THRESHOLD=0.85
# Google Document AI (vacío = deshabilitado; necesario para OCR document_ai)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# Alcance OAuth2 y plantilla del endpoint :process (placeholders {location}/{project}/{processor})
GOOGLE_CLOUD_SCOPE=https://www.googleapis.com/auth/cloud-platform
GOOGLE_DOCUMENT_AI_ENDPOINT_TEMPLATE=https://{location}-documentai.googleapis.com/v1/projects/{project}/locations/{location}/processors/{processor}:process
OCR_PROVIDER=docling_layout          # docling_layout | docling | docling_latin | handwriting | tesseract | fake
OCR_HANDWRITING_MODEL=               # modelo image-to-text (HuggingFace) para manuscritos; vacío = deshabilitado
OCR_TESSERACT_CMD=                   # ruta al ejecutable; requerido si OCR_PROVIDER=tesseract
OCR_TESSERACT_TESSDATA_DIR=          # ruta a carpeta con .traineddata; vacío = default del binario
OCR_TESSERACT_LANG=spa               # datos de idioma descargados en tessdata
OCR_DPI=300                          # resolución de rasterizado de PDF a imagen
OCR_PREPROCESS=true                  # aplica binarización adaptativa + deskew + denoise antes de OCR
OCR_STRUCTURE_WITH_MODEL=false       # true = estructura el texto con el modelo LLM activo (lento, ~2-3s/página)
ASR_CONFIDENCE_THRESHOLD=0.80
ASR_PROVIDER=whisper                 # whisper (local) | fake
ASR_MODEL=large-v3                   # tiny/base/small/medium/large-v1/large-v2/large-v3
ASR_DEVICE=auto                      # auto | cpu | cuda
ASR_COMPUTE_TYPE=int8                # int8 | float16 | float32
ASR_BEAM_SIZE=5
ASR_BEST_OF=5
ASR_VAD_FILTER=true                  # activa VAD de faster-whisper para omitir silencios
ASR_VAD_PARAMETERS={}                # parámetros JSON opcionales para VAD; vacío = defaults de faster-whisper
ASR_MIN_SPEECH_DURATION_MS=250
ASR_DIARIZATION_TOKEN=               # token de HuggingFace para pyannote.audio; vacío = fallback por energía
FFMPEG_PATH=                         # ruta explícita a ffmpeg.exe; vacío = imageio-ffmpeg / PATH. En Windows con pyannote.audio 4 debe ser el ffmpeg.exe del build 'full-shared'
HF_TOKEN=                            # token de HuggingFace compartido (pyannote, modelos)

# --- IA / AI providers ---
LLM_PROVIDER=anthropic
LLM_MODEL=__SET_ME__
LLM_API_KEY=__SET_ME__
LLM_API_BASE_URL=https://api.anthropic.com
LLM_API_VERSION=2023-06-01
# Base URL (compatible con OpenAI Chat Completions) de cada proveedor del dashboard /models
OPENAI_BASE_URL=https://api.openai.com
DEEPSEEK_BASE_URL=https://api.deepseek.com
KIMI_BASE_URL=https://api.moonshot.cn
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_SECONDS=60
# Routing por tarea (D4). JSON: {"extract_entities": {"provider":"openai","model":"gpt-4o-mini"},
#   "detect_contradictions": {"provider":"anthropic","model":"claude-3-5-sonnet-20241022"}}.
# Campos omitidos heredan del LLM default. Vacío o ausente = sin routing.
LLM_ROUTING={}
QUESTION_MAX_CHARS=2000
RETRIEVAL_TOP_K=8
# Constante k de Reciprocal Rank Fusion (FTS + vector). Valores usuales: 60.
RETRIEVAL_RRF_K=60
RETRIEVAL_SNIPPET_MAX_CHARS=1500
# Fracción mínima de términos de cada afirmación presentes en la evidencia citada (anti-alucinación)
ANSWER_MIN_GROUNDING_OVERLAP=0.6
# Fracción mínima de términos de la pregunta que deben existir en el expediente para no abstenerse
ABSTENTION_MIN_TERM_COVERAGE=0.6
PROMPTS_DIR=packages/prompts

# --- Embeddings / búsqueda híbrida ---
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=__SET_ME__
EMBEDDING_API_KEY=__SET_ME__
EMBEDDING_API_BASE_URL=                   # opcional para OpenAI compatible
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_CHARS=8000

# --- Presupuesto por expediente / Case budget ---
CASE_MAX_PROCESSING_COST=100
CASE_MAX_LLM_TOKENS=2000000
CASE_MAX_MEDIA_HOURS=50

# --- Semillas y cuentas de prueba / Seeds & test accounts ---
SEED_DATA_FILE=apps/api/seeds/data/seed_data.yaml
SEED_EMAIL_DOMAIN=example.test      # dominio reservado (RFC 2606), nunca real
SEED_DEFAULT_PASSWORD=__GENERATE__
# Admin de acceso rápido (opcional; vacío = no se crea)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
